FROM python:3.11-slim

# System libs baked once (LightGBM OpenMP, etc.)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Dependency layer — rebuild only when requirements.txt changes
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Entrypoint only (app code is volume-mounted at runtime for live edits)
COPY entrypoint.sh .
RUN chmod +x entrypoint.sh

EXPOSE 8501

# No apt/pip at runtime — start Streamlit only
CMD ["bash", "./entrypoint.sh"]
